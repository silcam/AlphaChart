{
  "name": "alphachart-server",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client"
  ],
  "dependencies": {
    "@types/cookie-session": "^2.0.37",
    "@types/express": "^5.0.6",
    "@types/express-fileupload": "^1.5.0",
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.13.0",
    "@types/supertest": "^7.2.0",
    "body-parser": "^2.3",
    "cookie-session": "^2.1.0",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.0",
    "immutability-helper": "^3.1.1",
    "memfs": "^4.x",
    "migrate": "^2.1.0",
    "mongodb": "^7.4.0",
    "nodemailer": "^9.0.1",
    "nodemailer-stub": "^1.2.1",
    "pdfkit": "^0.19.1",
    "puppeteer": "^25.x",
    "signal-exit": "^4.1.0",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "start": "concurrently -p \"[{name}]\" -n \"TS,Server,Client\"  -c yellow,green,magenta \"tsc -w\" \"yarn start-server\" \"yarn start-client\"",
    "start-server": "nodemon server/dist/server/src/server.js --watch server/dist/ --delay 2",
    "start-client": "node start-client.js",
    "test": "NODE_ENV=test vitest",
    "coverage": "NODE_ENV=test vitest --coverage",
    "start-test": "yarn reset-cypress-images && NODE_ENV=test-cypress yarn start",
    "cypress:run": "yarn reset-cypress-images && NODE_ENV=test-cypress concurrently --hide 1 -p \"[{name}]\" -n \"TS,Client,Cypress\"  -c yellow,green,magenta,orange \"tsc -w\" \"yarn start-test\" \"cypress run\"",
    "cypress:open": "yarn reset-cypress-images && NODE_ENV=test-cypress concurrently -p \"[{name}]\" -n \"TS,Client,Cypress\"  -c yellow,green,magenta,orange \"tsc -w\" \"yarn start-test\" \"cypress open --e2e --browser=chrome\"",
    "deploy": "bundle exec cap production deploy",
    "reset-cypress-images": "node reset-cypress-images.js"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "^10.0.3",
    "cypress": "^15.18.0",
    "cypress-file-upload": "^5.0.0",
    "nodemon": "^3.1.0",
    "vitest": "^4.1.9"
  },
  "packageManager": "yarn@4.13.0"
}
